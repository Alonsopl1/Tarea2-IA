# Copia este archivo a .env y ajusta si hace falta.
# No se necesitan claves de API ni cuentas: Ollama corre en local.

# Modelo de Ollama usado en la opción "LLM + Python"
OLLAMA_MODEL=llama3.2:3b

# URL de Ollama. En Docker Compose: http://ollama:11434 ; sin Docker: http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434

# Segundos máximos de espera de una respuesta del LLM
OLLAMA_TIMEOUT=180

# Servidor web. Con Docker se usa 0.0.0.0 dentro del contenedor.
ZOOLOGIC_HOST=127.0.0.1
PORT=8765

# Ruta al ejecutable de SWI-Prolog (opcional; por defecto se busca "swipl" en el PATH)
SWIPL=
